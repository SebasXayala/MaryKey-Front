# ------------------------------------------------------------------
# Backend
# ------------------------------------------------------------------
# Origen del backend Nest. Solo lo usa el servidor de Next, para el rewrite
# /api/backend/* -> $BACKEND_URL/api/v1/*  (ver next.config.ts).
BACKEND_URL=http://localhost:4000

# Ruta relativa: las peticiones salen al mismo origen y el rewrite las
# reenvía al backend. Así no hace falta que el backend habilite CORS.
# El día que lo habilite se puede poner aquí la URL absoluta del API.
NEXT_PUBLIC_API_URL=/api/backend

# Timeout de cada request en milisegundos
NEXT_PUBLIC_API_TIMEOUT=15000

# Simula SOLO lo que el backend todavía no tiene (tutoriales, newsletter y
# recuperación de contraseña). Auth, usuarios, roles y catálogo salen al
# servidor real: ver src/lib/api/backend-coverage.ts.
# Además, si el backend responde 401 en /categories o /products (hoy están
# detrás del guard JWT) la tienda cae al catálogo simulado en vez de
# quedarse vacía. En "false" TODO va al backend, sin excepciones.
NEXT_PUBLIC_API_MOCKS=true

# Id del rol que se asigna al registrarse desde la tienda.
# El backend exige role_id en POST /auth/register y protegió GET /roles con
# JWT, así que quien se registra no puede consultarlo: se fija aquí.
# Si se deja vacío, el front intenta leer /roles (funciona solo si el
# backend lo vuelve público).
NEXT_PUBLIC_DEFAULT_ROLE_ID=

# ------------------------------------------------------------------
# Sesión
# ------------------------------------------------------------------
# Nombre de la cookie donde se guarda el access token
NEXT_PUBLIC_SESSION_COOKIE=mk_session

# ------------------------------------------------------------------
# Panel de administración (/admin)
# ------------------------------------------------------------------
# No necesita configuración: entra quien tenga el rol 'admin' en el backend.
# El rol se asigna desde Clientes en el propio panel (PATCH /users/:id).
