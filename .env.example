# ------------------------------------------------------------------
# Backend
# ------------------------------------------------------------------
# Origen del backend Nest. Solo lo usa el servidor de Next, para el rewrite
# /api/backend/* -> $BACKEND_URL/api/v1/*  (ver next.config.ts).
BACKEND_URL=http://localhost:4000

# Ruta relativa: las peticiones salen al mismo origen y el rewrite las
# reenvía al backend. Así no hace falta que el backend habilite CORS.
# El día que lo habilite se puede poner aquí la URL absoluta del API.
NEXT_PUBLIC_API_URL=/api/backend

# Timeout de cada request en milisegundos
NEXT_PUBLIC_API_TIMEOUT=15000

# Simula SOLO lo que el backend todavía no tiene (catálogo, tutoriales,
# newsletter). Auth y usuarios ya salen al servidor real: ver
# src/lib/api/backend-coverage.ts.
# En "false" TODO va al backend y lo no implementado devuelve 404.
NEXT_PUBLIC_API_MOCKS=true

# ------------------------------------------------------------------
# Sesión
# ------------------------------------------------------------------
# Nombre de la cookie donde se guarda el access token
NEXT_PUBLIC_SESSION_COOKIE=mk_session
