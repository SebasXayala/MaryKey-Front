# ------------------------------------------------------------------
# Backend
# ------------------------------------------------------------------
# URL base del API (sin slash final). Ej: https://api.marykay.com/v1
NEXT_PUBLIC_API_URL=

# Timeout de cada request en milisegundos
NEXT_PUBLIC_API_TIMEOUT=15000

# Mientras el backend no exista, deja esto en "true": la app responde
# con datos simulados usando EXACTAMENTE los mismos servicios y tipos.
# Cuando te entreguen el backend: pon NEXT_PUBLIC_API_URL y esto en "false".
NEXT_PUBLIC_API_MOCKS=true

# ------------------------------------------------------------------
# Sesión
# ------------------------------------------------------------------
# Nombre de la cookie donde se guarda el access token
NEXT_PUBLIC_SESSION_COOKIE=mk_session
